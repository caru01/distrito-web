# ============================
# Variables de entorno - distrito-web
# Configura estas variables en Vercel (Settings > Environment Variables)
# ============================

# URL base de la API en Render (SIN barra al final, SIN /api/pedidos)
VITE_API_URL=https://distrito-api.onrender.com

# Puerto usado cuando VITE_API_URL=auto para pruebas LAN/Internet
VITE_API_PORT=3001

# Google Maps JavaScript API + Places API (New). Restringe esta clave por dominio HTTP.
VITE_GOOGLE_MAPS_API_KEY=

# Usa un Map ID propio en producción. DEMO_MAP_ID permite desarrollo inicial.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
